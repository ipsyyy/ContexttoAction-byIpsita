# Copy to .env and configure locally. The application never needs these values in Git.
USER_NAME=
DEFAULT_COUNTERPARTY=

# Live conversation, transcript analysis, and model-assisted chat.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Semantic retrieval and durable memory.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
SUPERMEMORY_API_KEY=
# CONTEXT_SUPERMEMORY_NAMESPACE=custom-namespace

# Public fact-checking.
TAVILY_API_KEY=

# Approved email sending to one controlled recipient.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
CONTEXT_AGENT_TEST_RECIPIENT=
# Optional default address for desktop drafts.
DEFAULT_RECIPIENT_EMAIL=

# Redacted hosted traces and synthetic evaluation experiments.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=context-to-action
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
CONTEXT_AGENT_TRACE_ENABLED=0

# Optional hosted scoring in Chat. Sends the question and candidate excerpts.
CONTEXT_AGENT_SUPERLINKED_ENABLED=0
SUPERLINKED_API_KEY=
# SIE_API_KEY is also accepted and takes precedence when both are set.
# SIE_BASE_URL=https://api.superlinked.com
# SIE_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B

# Explicit Cognee engineering demo commands only.
COGNEE_API_KEY=
COGNEE_BASE_URL=
# The tenant URL scopes Cloud requests. A separate COGNEE_TENANT_ID is optional metadata.

# Browser persistence and optional sponsor demo. Use a dedicated SQL user.
SINGLESTORE_URL=
# Alternatively, set all five split connection fields.
SINGLESTORE_HOST=
SINGLESTORE_PORT=
SINGLESTORE_USER=
SINGLESTORE_PASSWORD=
SINGLESTORE_DATABASE=
# SINGLESTORE_SSL_CA=/path/to/cluster-ca.pem

# Optional local browser settings.
# CONTEXT_WEB_PORT=8765
# CONTEXT_WEB_WORKSPACE=local-browser
# CONTEXT_WEB_MOSS_READ_ONLY=0
